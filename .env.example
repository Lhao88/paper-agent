APP_ENV=development
APP_MODE=single_user_local
API_HOST=127.0.0.1
API_PORT=8000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=research
DB_USER=research
DB_PASSWORD=
STORAGE_ROOT=.local-data
LOG_LEVEL=INFO

LLM_MODE=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_SCREEN_MODEL=
LLM_RESEARCH_MODEL=
LLM_OUTPUT_MODE=json_schema
LLM_TIMEOUT_SECONDS=120
LLM_MAX_INPUT_BYTES=120000
LLM_SCREEN_MAX_OUTPUT_TOKENS=1024
LLM_RESEARCH_MAX_OUTPUT_TOKENS=4096

SOURCE_MODE=mock
MOCK_CORPUS_PROFILE=minimal
RESEARCH_STRATEGY=B2
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_API_KEY=
ARXIV_BASE_URL=https://export.arxiv.org/api/query
CONTACT_EMAIL=
HTTP_USER_AGENT=AcademicWorkbench/0.1
ENABLE_ARXIV=false

MCP_ENABLED=false
MCP_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*"]
MCP_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

MAX_CANDIDATES=200
MAX_SCREEN_PAPERS=60
MAX_DEEP_READ_PAPERS=20
MAX_SOURCE_REQUESTS=20
MAX_SOURCE_RETRIES=1
READ_CONCURRENCY=3
MAX_LLM_CALLS=150
MAX_ESTIMATED_TOTAL_TOKENS=400000
MAX_RESEARCH_SECONDS=1200
MAX_SUPPLEMENT_ROUNDS=1
MAX_REVISION_ROUNDS=1
MAX_MODEL_RETRIES=1
MAX_DOWNLOAD_MB=30
MAX_PDF_PAGES=120
PDF_PARSE_TIMEOUT_SECONDS=60
MAX_CHUNKS_PER_PAPER=12
CHUNKS_PER_EXTRACTION_CALL=4
CHUNK_TARGET_TOKENS=700
